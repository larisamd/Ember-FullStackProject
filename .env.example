MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/ember?retryWrites=true&w=majority&appName=<app-name>
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_DATABASE=ember
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
PORT=3001

CUSTOMER_NAME=Customer Name
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=replace-with-a-strong-password

CHEF_NAME=Chef Name
CHEF_EMAIL=chef@example.com
CHEF_PASSWORD=replace-with-a-strong-password

ADMIN_NAME=Manager Name
ADMIN_EMAIL=manager@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
